# Rotate the OpenAI key that was shared in chat. Put only a fresh key here.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

INVITE_SIGNING_SECRET=

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local/dev/test fallback when Supabase env vars are absent.
INTERVIEW_AGENT_STORE_FILE=.local-data/store.json
NEXT_PUBLIC_MOCK_REALTIME=0
